# Source this example on the host BEFORE starting the container.
# For local overrides, copy to scripts/mcp_assets.env (ignored by Git).
# Public FuncBind release pinned to a revision; shared Dropbox links also work.
export NF_MODEL_URL='https://huggingface.co/mkirchmeyer/funcbind/resolve/f42d3daeb6e7c1fa2b20096f9a147aa3b1f8814f/nf_unified/model.pt'
export NF_MODEL_SHA256='872c4d933987db4d2dd3b93012359292bd85c058d649972b1cacb6c6e3db24bf'
export FB_MODEL_URL='https://huggingface.co/mkirchmeyer/funcbind/resolve/f42d3daeb6e7c1fa2b20096f9a147aa3b1f8814f/fb_unified/checkpoint.pth.tar'
export FB_MODEL_SHA256='cc489de2aee2b36a3a5f8eae44e084b03dc266cab7ec2f8ff2b707a28ef935f4'
# The folder link alone returns CDG_v2.zip. Keep preview=... to select only
# the checkpoint, and dl=1 to download it without Dropbox login/configuration.
export CDG_MODEL_URL='https://www.dropbox.com/scl/fo/p0l0cfgllouvh5rudz4tx/AIQWK_07O6Hx3hOPZexOTJA?rlkey=y7i01u8h0cncgxiyph97lzxll&dl=1&preview=checkpoint_e0025.pth.tar'
export CDG_MODEL_SHA256='9dbce36f33b1d3e9ba99e554979fc96331066ca24e1cda285f82117306a3d5f2'

# Leave MCP_MODEL_URL unset for a NEW fine-tuning run. It is only for downloading
# a separately trained density-conditioned model for generation; it is NOT the
# density-free FB_MODEL_URL above and does not select the training resume path.
